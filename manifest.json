{
  "manifest_version": 3,
  "name": "Peel",
  "version": "1.0.0",
  "description": "One look for every site: Paper, Dark, 1996, macOS, Typewriter and 25 more. Drag the corner to flip. No AI, no tracking.",
  "icons": {
    "16": "icons/peel16.png",
    "48": "icons/peel48.png",
    "128": "icons/peel128.png"
  },
  "action": {
    "default_title": "Peel this page",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/peel16.png",
      "48": "icons/peel48.png",
      "128": "icons/peel128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "js": [
        "src/styles.js",
        "src/early.js"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "src/core/dom.js",
        "src/core/storage.js",
        "src/core/registry.js",
        "src/adapters/hackernews.js",
        "src/adapters/reddit.js",
        "src/adapters/amazon.js",
        "src/adapters/flipkart.js",
        "src/adapters/generic-news.js",
        "src/experiences/broadsheet.js",
        "src/experiences/swipe.js",
        "src/experiences/cards.js",
        "src/experiences/hush.js",
        "src/fx/fx.js",
        "src/fx/particles.js",
        "src/fx/sound.js",
        "src/fx/companion.js",
        "src/editions/light.js",
        "src/editions/dark.js",
        "src/editions/noir.js",
        "src/editions/paper.js",
        "src/editions/glowy.js",
        "src/editions/y2100.js",
        "src/editions/y1996.js",
        "src/editions/y2007.js",
        "src/editions/mac1984.js",
        "src/editions/terminal.js",
        "src/editions/vhs.js",
        "src/editions/blueprint.js",
        "src/editions/sketch.js",
        "src/editions/comic.js",
        "src/editions/polaroid.js",
        "src/editions/snow.js",
        "src/editions/rain.js",
        "src/editions/underwater.js",
        "src/editions/pest.js",
        "src/editions/haunted.js",
        "src/editions/redacted.js",
        "src/editions/matrix.js",
        "src/editions/focus.js",
        "src/editions/bigtype.js",
        "src/editions/gravity.js",
        "src/editions/asteroids.js",
        "src/editions/konami.js",
        "src/editions/macos.js",
        "src/editions/win11.js",
        "src/editions/win95.js",
        "src/editions/typewriter.js",
        "src/ui/curl.js",
        "src/toys/toys.js",
        "src/toys/tools.js",
        "src/ui/transitions.js",
        "src/ui/swatches.js",
        "src/ui/picker.js",
        "src/core/peel.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/peel128.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
